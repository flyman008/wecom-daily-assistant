# Copy the required values to this project's .runtime/wecom.env.
# Never reuse or copy another enterprise's .env or .runtime directory.

WECOM_BOT_ID=
WECOM_BOT_SECRET=
WECOM_HEARTBEAT_MS=30000
WECOM_MAX_RECONNECT_ATTEMPTS=-1
GATEWAY_HEALTH_PORT=8788

DATABASE_PATH=.runtime/data/poc.sqlite
ATTACHMENT_DIR=.runtime/attachments
ATTACHMENT_MAX_BYTES=52428800
WEEK_BOUNDARY=natural_week
PLAN_REMINDER_AT=09:00
DAILY_REMINDER_AT=17:30
WEEKLY_GENERATE_AT=18:00

# LLM provider: mock | ark | openai_compatible. POC defaults to mock.
# Keep secrets only in this project's .runtime/wecom.env.
AGENT_PROVIDER=mock

# Volcengine Ark Anthropic-compatible endpoint. Recommended first real POC provider.
ARK_BASE_URL=
ARK_API_KEY=
ARK_MODEL=ark-code-latest
ARK_TIMEOUT_MS=60000
ARK_MAX_TOKENS=2048

# Optional generic OpenAI-compatible /chat/completions provider.
# Base URL normally includes /v1, for example https://provider.example/v1.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_TIMEOUT_MS=60000
OPENAI_COMPATIBLE_MAX_TOKENS=2048

# Optional independent local Agent service. This is the future server boundary.
AGENT_SERVICE_ENABLED=false
AGENT_HOST=127.0.0.1
AGENT_PORT=8790
AGENT_SERVICE_URL=
AGENT_INTERNAL_KEY=

# Management API and static frontend.
API_HOST=127.0.0.1
PORT=3000
POC_ACCESS_CODE=
API_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DEMO_MODE=false
REPORT_BASE_URL=
PUBLIC_WEEKLY_USER_NAME=
PUBLIC_WEEKLY_EMPLOYEE_NAME=

# Local minimal POC overrides live in .runtime/local-poc.env.
# Documents CLI authorization is isolated to .runtime/wecom-cli.
DIRECTORY_SHEET_URL=
WECOM_CLI_ENTRY=
GATEWAY_ENABLED=true
