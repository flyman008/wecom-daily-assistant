{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["packages/*/src", "apps/*/src", "apps/web/**/*.test.ts", "scripts/sync-directory.ts"]
}
